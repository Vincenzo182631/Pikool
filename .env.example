# Copy to .env.local and fill in. Never commit real secrets.

# ---- App ----
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://user:password@localhost:5432/pikool?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/pikool?schema=public"

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-access-secret-change-me-at-least-32-chars-long"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-at-least-32-chars-long"
AUTH_COOKIE_DOMAIN="localhost"

# ---- OAuth (optional in dev) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ---- Maps ----
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
GOOGLE_MAPS_SERVER_KEY=""

# ---- Media (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Redis (Upstash) — optional in dev (falls back to in-memory) ----
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Email (Resend) — optional in dev (falls back to console) ----
RESEND_API_KEY=""
EMAIL_FROM="PicklePlay <noreply@pickleplay.app>"

# ---- Realtime ----
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# ---- Misc ----
WEATHER_API_KEY=""
